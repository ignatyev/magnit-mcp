OWNER_KEY_FILE=./data/owner-key
SESSION_FILE=./data/magnit-session.enc
CART_OPERATIONS_FILE=./data/cart-operations.enc
CART_LOCK_FILE=./data/cart.lock
ANDROID_DEVICE_SERIAL=
# Optional: API usage is separately billed from ChatGPT subscriptions.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional: PRIVATE GitHub Issues queue to connect this Android Chrome to ChatGPT.
# Create a separate PRIVATE repository; do not use this public source repository.
# Fine-grained GitHub token: only this private repo, Issues read/write and Metadata read.
GITHUB_QUEUE_REPO=
GITHUB_QUEUE_TOKEN=
# Limit remote browser commands to shops you explicitly trust.
BROWSER_QUEUE_ALLOWED_HOSTS=magnit.ru,vkusvill.ru,5ka.ru
