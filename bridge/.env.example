# Local Termux use: Node binds only to 127.0.0.1 and Secure cookies are off only for loopback.
PUBLIC_BASE_URL=http://127.0.0.1:8080
HOST=127.0.0.1
PORT=8080
TRUST_PROXY=0
# Optional: set this only when `adb devices -l` lists multiple online devices.
ANDROID_DEVICE_SERIAL=
SESSION_FILE=./data/magnit-session.enc
CART_OPERATIONS_FILE=./data/cart-operations.enc

# Generate the MCP token with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
MCP_BEARER_TOKEN=replace-with-a-long-random-token
# Local loopback UI opens without a service password. A private persistent key is created at OWNER_KEY_FILE.
OWNER_KEY_FILE=./data/owner-key
# Required only for remote HTTPS owner UI. Leave unset in local Termux mode.
# Existing local deployments may keep their old value; it is used to decrypt existing saved sessions.
# PHONE_ACCESS_SECRET=replace-with-a-different-long-random-passphrase

# For remote MCP, change PUBLIC_BASE_URL to a real HTTPS address, set HOST=0.0.0.0,
# TRUST_PROXY=1, and run behind a TLS proxy that overwrites forwarded headers.
